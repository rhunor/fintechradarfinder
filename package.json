{
  "name": "fintech-deal-radar",
  "version": "1.0.0",
  "private": true,
  "description": "Monitors news feeds for US/Canada fintech funding and acquisition announcements, alerts via Telegram.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:init": "tsx scripts/db-init.ts",
    "check-sources": "tsx scripts/check-sources.ts",
    "dry-run": "tsx scripts/dry-run.ts",
    "telegram:set-webhook": "tsx scripts/set-webhook.ts",
    "test:fast": "vitest run --exclude \"tests/classifier-live.test.ts\"",
    "db:reset-metrics": "tsx scripts/reset-metrics.ts"
  },
  "dependencies": {
    "@google/genai": "^2.24.0",
    "fast-xml-parser": "^5.11.1",
    "grammy": "^1.46.0",
    "mongodb": "^7.6.0",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "undici": "^7.29.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
