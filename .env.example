# ---------------------------------------------------------------------------
# Fintech Deal Radar — environment variables
#
# Local development: copy this file to .env.local and fill in real values.
# Production: set these in Vercel > Project > Settings > Environment Variables.
# Never commit .env.local — it is gitignored.
# ---------------------------------------------------------------------------

# --- MongoDB Atlas (free M0 tier) -----------------------------------------
# Connection string from Atlas > Connect > Drivers. Create the cluster in
# AWS us-east-1 so it sits next to the Vercel functions (region iad1).
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0"
# Database name inside the cluster. Safe to leave as the default.
MONGODB_DB="fintech_deal_radar"
# How long the driver may spend finding a server. The default suits a function
# in the same region as the cluster; raise it if running scripts from a slow
# or distant connection.
MONGODB_SERVER_SELECTION_TIMEOUT_MS="8000"

# --- Telegram --------------------------------------------------------------
# From @BotFather when you created the bot. Treat as a password: anyone with
# this token can control the bot.
TELEGRAM_BOT_TOKEN="123456789:AA..."
# Your personal chat ID. Alerts go here and nowhere else; updates from any
# other chat are ignored.
TELEGRAM_CHAT_ID="000000000"
# A random string you invent. Telegram echoes it back in the
# X-Telegram-Bot-Api-Secret-Token header so we can reject forged webhook calls.
# Generate one with: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=""

# --- Scheduling and access control ----------------------------------------
# Random string protecting /api/cron/*  and /api/admin/*. cron-job.org sends it
# as "Authorization: Bearer <value>". Generate with: openssl rand -hex 32
CRON_SECRET=""
# Password for the /deals dashboard login.
DASHBOARD_PASSWORD=""
# Public URL of the deployed app, no trailing slash. Used to register the
# Telegram webhook. e.g. https://fintech-deal-radar.vercel.app
APP_URL="http://localhost:3000"

# --- AI classifier (Google Gemini only — the whole point is the free tier) ---
# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# Flash-Lite has the most generous free tier. Verified working 2026-09-22.
GEMINI_MODEL="gemini-3.5-flash-lite"
# Stop calling this model after this many requests in a UTC day. Above 80% of
# it we classify every other cycle so more items batch into each request.
GEMINI_DAILY_LIMIT="900"
# Fallback model, used once GEMINI_MODEL's daily allowance is spent. Google's
# free-tier limits are PER MODEL, so this is a genuinely separate allowance.
# Leave empty to skip straight to unverified alerts instead.
GEMINI_FALLBACK_MODEL="gemini-3.1-flash-lite"
GEMINI_FALLBACK_DAILY_LIMIT="200"
# Only alert when the classifier is at least this confident.
ALERT_MIN_CONFIDENCE="0.7"

# --- HTTP identity ---------------------------------------------------------
# SEC EDGAR returns 403 without a descriptive User-Agent containing real
# contact info. Format: "Company Name your@email.com"
SEC_USER_AGENT="Your Name your@email.com"
# Sent to every non-SEC feed so site owners can identify and contact us.
APP_USER_AGENT="FintechDealRadar/1.0 (+https://github.com/you/repo; you@email.com)"

# --- Tuning (optional; defaults are sensible) ------------------------------
# Hard stop for one poll cycle, against Vercel's 60s maxDuration. Raised from
# the original 25s because free-tier Gemini has a ~16s median response time.
CYCLE_BUDGET_MS="45000"
CLASSIFY_BUDGET_MS="30000"
FEED_TIMEOUT_MS="5000"
ARTICLE_TIMEOUT_MS="5000"
MAX_ARTICLE_FETCHES="5"
MAX_CLASSIFIER_BATCH="15"
